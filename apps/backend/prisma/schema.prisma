generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  role          UserRole  @default(CUSTOMER)
  avatar        String?
  isVerified    Boolean   @default(false) @map("is_verified")
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  wishlists        Wishlist[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  preorderSlots    PreorderSlot[]
  cart             Cart?
  authoredPosts    BlogPost[]     @relation("BlogPostAuthor")
  approvedProducts Product[]      @relation("ApprovedProducts")
  otpCodes         OtpCode[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OtpChannel {
  EMAIL
  PHONE
}

model OtpCode {
  id                    String     @id @default(cuid())
  userId                String     @map("user_id")
  verificationSessionId String     @unique @map("verification_session_id")
  channel               OtpChannel
  target                String
  codeHash              String     @map("code_hash")
  expiresAt             DateTime   @map("expires_at")
  lastSentAt            DateTime   @default(now()) @map("last_sent_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  consumedAt            DateTime?  @map("consumed_at")
  invalidatedAt         DateTime?  @map("invalidated_at")
  attempts              Int        @default(0)
  resendCount           Int        @default(0) @map("resend_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt])
  @@index([target, channel, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Address {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  label      String?
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  phone      String
  street     String
  city       String
  state      String
  country    String   @default("Nigeria")
  postalCode String?  @map("postal_code")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId, isDefault])
  @@map("addresses")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Product {
  id                     String                @id @default(cuid())
  name                   String
  slug                   String                @unique
  description            String
  shortDesc              String?               @map("short_desc")
  categoryId             String                @map("category_id")
  basePrice              Decimal               @map("base_price") @db.Decimal(12, 2)
  currency               String                @default("NGN")
  sourceCountry          String                @default("China") @map("source_country")
  stockType              ProductStockType      @default(IN_STOCK) @map("stock_type")
  approvalStatus         ProductApprovalStatus @default(PENDING_REVIEW) @map("approval_status")
  isPublished            Boolean               @default(false) @map("is_published")
  sku                    String?               @unique
  weight                 Decimal?              @db.Decimal(8, 2)
  isFeatured             Boolean               @default(false) @map("is_featured")
  isActive               Boolean               @default(true) @map("is_active")
  adminApprovedAt        DateTime?             @map("admin_approved_at")
  approvedByUserId       String?               @map("approved_by_user_id")
  inventoryQuantity      Int?                  @map("inventory_quantity")
  preorderSlotsTotal     Int?                  @map("preorder_slots_total")
  preorderSlotsRemaining Int?                  @map("preorder_slots_remaining")
  preorderStartsAt       DateTime?             @map("preorder_starts_at")
  preorderEndsAt         DateTime?             @map("preorder_ends_at")
  estimatedArrivalAt     DateTime?             @map("estimated_arrival_at")
  trendingScore          Decimal               @default(0) @map("trending_score") @db.Decimal(10, 4)
  salesVelocity7d        Int                   @default(0) @map("sales_velocity_7d")
  salesVelocity30d       Int                   @default(0) @map("sales_velocity_30d")
  unitsSoldTotal         Int                   @default(0) @map("units_sold_total")
  metaTitle              String?               @map("meta_title")
  metaDescription        String?               @map("meta_description")
  tags                   String[]              @default([])
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  category          Category           @relation(fields: [categoryId], references: [id])
  approvedBy        User?              @relation("ApprovedProducts", fields: [approvedByUserId], references: [id])
  variants          ProductVariant[]
  images            ProductImage[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  inventoryReservations InventoryReservation[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  preorderCampaigns PreorderCampaign[]

  @@index([categoryId])
  @@index([stockType, approvalStatus, isActive, isPublished])
  @@index([isFeatured, isActive, isPublished])
  @@index([trendingScore, salesVelocity7d, isActive, isPublished])
  @@index([preorderEndsAt])
  @@index([slug])
  @@map("products")
}

enum ProductStockType {
  IN_STOCK
  PREORDER
}

enum ProductApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  name       String
  sku        String   @unique
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  attributes Json     @default("{}")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]
  inventoryReservations InventoryReservation[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String   @map("cart_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  quantity      Int
  priceSnapshot Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  currency      String   @default("NGN")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                        String            @id @default(cuid())
  orderNumber               String            @unique @map("order_number")
  userId                    String            @map("user_id")
  status                    OrderStatus       @default(PENDING)
  stockTypeSnapshot         ProductStockType? @map("stock_type_snapshot")
  inspectionStatus          InspectionStatus  @default(NOT_REQUIRED) @map("inspection_status")
  paymentReference          String?           @map("payment_reference")
  subtotal                  Decimal           @db.Decimal(12, 2)
  shippingFee               Decimal           @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  tax                       Decimal           @default(0) @db.Decimal(12, 2)
  discount                  Decimal           @default(0) @db.Decimal(12, 2)
  total                     Decimal           @db.Decimal(12, 2)
  currency                  String            @default("NGN")
  shippingAddressId         String?           @map("shipping_address_id")
  billingAddressId          String?           @map("billing_address_id")
  trackingNumber            String?           @map("tracking_number")
  trackingCarrier           String?           @map("tracking_carrier")
  trackingUrl               String?           @map("tracking_url")
  shippedAt                 DateTime?         @map("shipped_at")
  deliveredAt               DateTime?         @map("delivered_at")
  paidAt                    DateTime?         @map("paid_at")
  guestAccessTokenHash      String?           @map("guest_access_token_hash")
  guestAccessTokenExpiresAt DateTime?         @map("guest_access_token_expires_at")
  notes                     String?
  cancelReason              String?           @map("cancel_reason")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  shippingAddress Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]
  inventoryReservations InventoryReservation[]

  @@index([userId, status, createdAt])
  @@index([paymentReference])
  @@index([trackingNumber])
  @@index([inspectionStatus])
  @@index([guestAccessTokenHash])
  @@index([guestAccessTokenExpiresAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  INSPECTION_PENDING
  INSPECTION_PASSED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum InspectionStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
}

model OrderItem {
  id                 String           @id @default(cuid())
  orderId            String           @map("order_id")
  productId          String           @map("product_id")
  variantId          String?          @map("variant_id")
  name               String
  price              Decimal          @db.Decimal(12, 2)
  quantity           Int
  total              Decimal          @db.Decimal(12, 2)
  stockTypeSnapshot  ProductStockType @map("stock_type_snapshot")
  inspectionRequired Boolean          @default(false) @map("inspection_required")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  inventoryReservation InventoryReservation?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                    String          @id @default(cuid())
  orderId               String          @map("order_id")
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  reference             String          @unique
  providerRef           String?         @unique @map("provider_ref")
  providerTransactionId String?         @map("provider_transaction_id")
  accessCode            String?         @map("access_code")
  authorizationCode     String?         @map("authorization_code")
  authorizationUrl      String?         @map("authorization_url")
  customerEmail         String?         @map("customer_email")
  amount                Decimal         @db.Decimal(12, 2)
  amountCaptured        Decimal?        @map("amount_captured") @db.Decimal(12, 2)
  amountRefunded        Decimal         @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  fees                  Decimal?        @db.Decimal(12, 2)
  currency              String          @default("NGN")
  channel               String?
  gatewayResponse       String?         @map("gateway_response")
  metadata              Json?
  paidAt                DateTime?       @map("paid_at")
  verifiedAt            DateTime?       @map("verified_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@index([orderId, status])
  @@index([provider, status])
  @@index([paidAt])
  @@map("payments")
}

model PaymentEvent {
  id         String          @id @default(cuid())
  paymentId  String          @map("payment_id")
  provider   PaymentProvider
  eventType  String          @map("event_type")
  eventId    String?         @unique @map("event_id")
  status     PaymentStatus
  payload    Json
  receivedAt DateTime        @default(now()) @map("received_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, receivedAt])
  @@index([provider, eventType])
  @@map("payment_events")
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
}

model InventoryReservation {
  id          String                     @id @default(cuid())
  orderId     String                     @map("order_id")
  orderItemId String                     @unique @map("order_item_id")
  productId   String                     @map("product_id")
  variantId   String?                    @map("variant_id")
  stockType   ProductStockType           @map("stock_type")
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime                   @map("expires_at")
  confirmedAt DateTime?                  @map("confirmed_at")
  releasedAt  DateTime?                  @map("released_at")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId, status])
  @@index([productId, variantId, status])
  @@index([expiresAt, status])
  @@map("inventory_reservations")
}

enum InventoryReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @map("order_id")
  trackingNumber String?        @unique @map("tracking_number")
  carrier        String?
  status         ShipmentStatus @default(PENDING)
  originCountry  String         @default("China") @map("origin_country")
  destCountry    String         @default("Nigeria") @map("dest_country")
  estimatedAt    DateTime?      @map("estimated_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  order  Order           @relation(fields: [orderId], references: [id])
  events ShipmentEvent[]

  @@index([orderId, status])
  @@map("shipments")
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_WAREHOUSE
  SHIPPED
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  LOCAL_DELIVERY
  DELIVERED
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String   @map("shipment_id")
  status      String
  location    String?
  description String?
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model PreorderCampaign {
  id           String         @id @default(cuid())
  productId    String         @map("product_id")
  title        String
  description  String?
  targetQty    Int            @map("target_qty")
  currentQty   Int            @default(0) @map("current_qty")
  pricePerUnit Decimal        @map("price_per_unit") @db.Decimal(12, 2)
  status       CampaignStatus @default(DRAFT)
  startsAt     DateTime       @map("starts_at")
  endsAt       DateTime       @map("ends_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  product Product        @relation(fields: [productId], references: [id])
  slots   PreorderSlot[]

  @@index([productId, status])
  @@index([startsAt, endsAt])
  @@map("preorder_campaigns")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  FUNDED
  ORDERED
  CLOSED
  CANCELLED
}

model PreorderSlot {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  userId     String   @map("user_id")
  quantity   Int
  amount     Decimal  @db.Decimal(12, 2)
  isPaid     Boolean  @default(false) @map("is_paid")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign PreorderCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("preorder_slots")
}

model Review {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  rating    Int
  title     String?
  comment   String?
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @default("My Wishlist")
  createdAt DateTime @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String   @map("wishlist_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  excerpt         String
  content         String
  coverImage      String?        @map("cover_image")
  categoryId      String?        @map("category_id")
  authorId        String?        @map("author_id")
  authorName      String?        @map("author_name")
  status          BlogPostStatus @default(DRAFT)
  tags            String[]       @default([])
  readingTimeMins Int?           @map("reading_time_mins")
  seoTitle        String?        @map("seo_title")
  seoDescription  String?        @map("seo_description")
  views           Int            @default(0)
  featured        Boolean        @default(false)
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  category BlogCategory? @relation(fields: [categoryId], references: [id])
  author   User?         @relation("BlogPostAuthor", fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([featured, status, publishedAt])
  @@index([slug])
  @@map("blog_posts")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

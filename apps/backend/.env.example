# ============================================
# Backend Environment Variables
# Copy to .env and fill in actual values
# ============================================

DATABASE_URL="postgresql://postgres:password@localhost:5432/yurdeals?schema=public"
NODE_ENV="development"
PORT=4000
API_VERSION="v1"

JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING_64_CHARS"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING"
VITE_WHATSAPP_BUSINESS_NUMBER="2348000000000"

CORS_ORIGIN="http://localhost:5173"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cloudinary product image uploads
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

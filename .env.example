# ============================================
# YurDeals Environment Variables
# Copy to .env and fill in actual values
# ============================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/yurdeals?schema=public"

# ---- Backend Server ----
NODE_ENV="development"
PORT=4000
API_VERSION="v1"

# ---- Security ----
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING_64_CHARS"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
COOKIE_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING"

# ---- CORS ----
CORS_ORIGIN="http://localhost:5173"

# ---- Rate Limiting ----
# Recommended dev defaults: 1-minute windows with generous request budgets.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
ORDER_RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_MAX_REQUESTS=60
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=60
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX_REQUESTS=600
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=600

# ---- Frontend (Vite) ----
VITE_API_URL="http://localhost:4000/api/v1"
# E.164-style WhatsApp number without +, spaces, or dashes.
VITE_WHATSAPP_BUSINESS_NUMBER="2348000000000"

# ---- Payment Gateways (Phase 2+) ----
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CALLBACK_URL="http://localhost:5173/payment-return"
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""
FLUTTERWAVE_CALLBACK_URL="http://localhost:5173/payment-return"

# ---- File Storage (Phase 2+) ----
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ============================================
# YurDeals Environment Variables
# Copy to .env and fill in actual values
# ============================================

# ---- Database ----
# Local development can use a direct URL like:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/yurdeals?schema=public"
# Production should prefer a pooled connection string, for example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public&connection_limit=5&sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/yurdeals?schema=public"

# ---- Backend Server ----
NODE_ENV="development"
PORT=4000
API_VERSION="v1"

# ---- Security ----
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING_64_CHARS"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
COOKIE_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING"
COOKIE_SAME_SITE="lax"
# Defaults to true in production and false outside production when omitted.
CSRF_ENABLED=false

# ---- Optional Seed Admin Bootstrap ----
# Used only when running: npm run db:seed -w apps/backend
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ---- CORS ----
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ---- Rate Limiting ----
# Recommended dev defaults: 1-minute windows with generous request budgets.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
ORDER_RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_MAX_REQUESTS=60
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=60
PAYMENT_RECONCILIATION_THRESHOLD_MINUTES=15
PAYMENT_RECONCILIATION_BATCH_SIZE=50
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX_REQUESTS=600
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=600

# ---- Fraud / Risk Review ----
# These thresholds are operational only. They should not change customer checkout UX.
RISK_MEDIUM_ORDER_TOTAL_NGN=150000
RISK_HIGH_ORDER_TOTAL_NGN=350000
RISK_EXTREME_ORDER_TOTAL_NGN=1000000
RISK_GUEST_ELEVATED_TOTAL_NGN=150000
RISK_PREORDER_SPIKE_QTY_THRESHOLD=4
RISK_PREORDER_SPIKE_TOTAL_QTY_THRESHOLD=6
RISK_REPEATED_ORDER_LOOKBACK_MINUTES=15
RISK_REPEATED_ORDER_IP_THRESHOLD=4
RISK_PAYMENT_RETRY_ATTEMPTS_THRESHOLD=4
RISK_FAILED_PAYMENT_ATTEMPTS_THRESHOLD=2
RISK_LOW_SIGNAL_POINTS_FOR_MEDIUM=2
RISK_LOW_SIGNAL_POINTS_FOR_HIGH=4
RISK_MEDIUM_SIGNAL_POINTS_FOR_HIGH=2

# ---- Frontend (Vite) ----
VITE_API_URL="http://localhost:4000/api/v1"
# E.164-style WhatsApp number without +, spaces, or dashes.
VITE_WHATSAPP_BUSINESS_NUMBER="2348000000000"

# ---- Payment Gateways (Phase 2+) ----
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CALLBACK_URL="http://localhost:4000/payment-return"
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""
FLUTTERWAVE_CALLBACK_URL="http://localhost:4000/payment-return"

# ---- File Storage (Phase 2+) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Email Notifications ----
# Set EMAIL_ENABLED=true only after RESEND_API_KEY and sender domain are configured.
EMAIL_ENABLED=false
RESEND_API_KEY=""
EMAIL_FROM="YurDeals <orders@yurdeals.com>"
EMAIL_REPLY_TO="support@yurdeals.com"

# ---- Error Monitoring ----
# Optional. Set SENTRY_DSN only in production/staging secret storage.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE=0.05
